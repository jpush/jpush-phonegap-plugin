<?xml version='1.0' encoding='utf-8'?>
<plugin id="jpush-phonegap-plugin"
  version="6.0.4"
  xmlns="http://apache.org/cordova/ns/plugins/1.0"
  xmlns:android="http://schemas.android.com/apk/res/android">

  <name>JPush</name>
  <description>JPush SDK for Cordova/PhoneGap</description>
  <license>MIT</license>
  <keywords>JPush, push, notifications</keywords>
  <repo>https://github.com/jpush/jpush-phonegap-plugin.git</repo>
  <issue>https://github.com/jpush/jpush-phonegap-plugin/issues</issue>

  <engines>
    <engine name="cordova" version=">=3.0.0" />
  </engines>

  <!-- Config for iOS -->
  <platform name="ios">
    <config-file target="config.xml" parent="/*">
      <feature name="JPushPlugin">
        <param name="ios-package" value="JPushPlugin" />
      </feature>
    </config-file>

    <header-file src="src/ios/Plugins/JPushPlugin.h" />
    <source-file src="src/ios/Plugins/JPushPlugin.m" />

    <resource-file src="src/ios/PushConfig.plist" />

    <podspec>
      <pods>
        <pod name="JPush" spec="6.1.0" />
      </pods>
    </podspec>

    <dependency id="cordova-plugin-device" />
    <dependency id="cordova-plugin-jcore" />
  </platform>

  <!-- Config for Android -->
  <platform name="android">
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="JPushPlugin">
        <param name="android-package" value="cn.jpush.phonegap.JPushPlugin" />
      </feature>
    </config-file>

    <config-file target="AndroidManifest.xml" parent="/manifest">
      <!-- JPush required permissions and receiver -->
      <uses-permission android:name="android.permission.INTERNET" />
      <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
      <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
      <uses-permission android:name="android.permission.READ_PHONE_STATE" />
      <uses-permission android:name="android.permission.WAKE_LOCK" />
      <uses-permission android:name="android.permission.VIBRATE" />
      <uses-permission android:name="android.permission.RECEIVE_USER_PRESENT" />
    </config-file>

    <config-file target="AndroidManifest.xml" parent="/manifest/application">
      <receiver
        android:name="cn.jpush.phonegap.JPushPlugin$JPushPluginReceiver"
        android:enabled="true"
        android:exported="false">
        <intent-filter>
          <action android:name="cn.jpush.android.intent.RECEIVE_MESSAGE" />
          <category android:name="${applicationId}" />
        </intent-filter>
      </receiver>
    </config-file>

    <source-file src="src/android/JPushPlugin.java" target-dir="src/cn/jpush/phonegap" />

    <framework src="cn.jiguang.sdk:jpush:6.1.0" />

    <dependency id="cordova-plugin-device" />
    <dependency id="cordova-plugin-jcore" />
  </platform>

  <!-- JS module -->
  <js-module src="www/JPushPlugin.js" name="JPushPlugin">
    <clobbers target="JPushPlugin" />
  </js-module>
</plugin>